---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Dashboard Admin | La Ragazza' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-ragazza-bg text-ragazza-dark">
    <div class="grid min-h-screen grid-cols-1 md:grid-cols-[260px_1fr]">
      <aside class="border-r border-ragazza-primary/15 bg-white/80 p-6 backdrop-blur">
        <div class="mb-10">
          <p class="font-cinzel text-xs uppercase tracking-[0.24em] text-ragazza-accent">Panel</p>
          <h1 class="mt-2 font-cinzel text-2xl text-ragazza-primary">La Ragazza CMS</h1>
        </div>

        <nav aria-label="Admin navigation" class="space-y-2 text-sm">
          <a href="/admin" class="block rounded-md border border-ragazza-primary/20 bg-ragazza-primary px-3 py-2 font-cinzel text-xs uppercase tracking-widest text-white">Overview</a>
          <a href="/admin/home" class="block rounded-md px-3 py-2 text-ragazza-secondary/80 hover:bg-ragazza-primary/5">Home</a>
          <a href="/admin/about" class="block rounded-md px-3 py-2 text-ragazza-secondary/80 hover:bg-ragazza-primary/5">About</a>
          <a href="#" class="block rounded-md px-3 py-2 text-ragazza-secondary/80 hover:bg-ragazza-primary/5">Menu</a>
          <a href="#" class="block rounded-md px-3 py-2 text-ragazza-secondary/80 hover:bg-ragazza-primary/5">Gallery</a>
          <a href="#" class="block rounded-md px-3 py-2 text-ragazza-secondary/80 hover:bg-ragazza-primary/5">FAQ</a>
          <a href="#" class="block rounded-md px-3 py-2 text-ragazza-secondary/80 hover:bg-ragazza-primary/5">Contact</a>
        </nav>
      </aside>

      <main class="p-6 md:p-10">
        <header class="mb-8 flex items-center justify-between">
          <div>
            <p class="font-cinzel text-xs uppercase tracking-[0.2em] text-ragazza-accent">Administracion</p>
            <h2 class="font-cinzel text-3xl text-ragazza-primary">Contenido del Sitio</h2>
          </div>
          <span class="rounded-full border border-ragazza-primary/20 px-4 py-1 text-xs font-semibold text-ragazza-secondary/70">Sin autenticacion (modo desarrollo)</span>
        </header>
        <slot />
      </main>
    </div>
  </body>
</html>

