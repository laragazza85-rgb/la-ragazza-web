---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url) as 'es' | 'en';

const messages = {
  es: {
    title: '404',
    heading: 'Ups! Esta página no existe',
    description: 'La página que buscas pudo haber sido movida, eliminada o quizás nunca existió.',
    homeLink: 'Volver al Inicio',
    menuLink: 'Ver el Menú',
    galleryLink: 'Ver Galería',
    whatsappLabel: 'Contáctanos por WhatsApp',
    whatsappText: 'Hola, me gustaría hacer una consulta sobre La Ragazza',
  },
  en: {
    title: '404',
    heading: 'Oops! This page does not exist',
    description: 'The page you are looking for may have been moved, deleted, or perhaps never existed.',
    homeLink: 'Back to Home',
    menuLink: 'View Menu',
    galleryLink: 'View Gallery',
    whatsappLabel: 'Contact us on WhatsApp',
    whatsappText: 'Hello, I would like to make an inquiry about La Ragazza',
  },
};

const content = messages[lang];
const whatsappNumber = '573133494150';
const whatsappEncodedText = encodeURIComponent(content.whatsappText);
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${whatsappEncodedText}`;
---

<Layout title={`${content.title} | La Ragazza`} description={content.description}>
  <main class="min-h-screen flex items-center justify-center bg-ragazza-bg px-4">
    <div class="max-w-lg w-full text-center">

      <!-- Decorative pasta icon -->
      <div class="mb-8">
        <svg class="w-24 h-24 mx-auto text-ragazza-primary/20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-4h2v2h-2zm1-10c-1.66 0-3 1.34-3 3h2c0-.55.45-1 1-1s1 .45 1 1c0 1-2 1.5-2 4h2c0-1.5 2-2 2-4 0-1.66-1.34-3-3-3z"/>
        </svg>
      </div>

      <!-- 404 Number -->
      <h1 class="font-cinzel text-[10rem] leading-none text-ragazza-primary/10 select-none">
        {content.title}
      </h1>

      <!-- Heading -->
      <h2 class="font-cinzel text-3xl md:text-4xl text-ragazza-primary mt-[-2rem] mb-6">
        {content.heading}
      </h2>

      <!-- Description -->
      <p class="font-lora text-lg text-ragazza-secondary/80 mb-10 leading-relaxed">
        {content.description}
      </p>

      <!-- Navigation Links -->
      <nav class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
        <a
          href={`/${lang}/`}
          class="font-cinzel text-sm uppercase tracking-widest px-6 py-3 bg-ragazza-primary text-white hover:bg-ragazza-dark transition-colors duration-300"
        >
          {content.homeLink}
        </a>
        <a
          href={`/${lang}/menu`}
          class="font-cinzel text-sm uppercase tracking-widest px-6 py-3 border border-ragazza-primary text-ragazza-primary hover:bg-ragazza-primary hover:text-white transition-colors duration-300"
        >
          {content.menuLink}
        </a>
        <a
          href={`/${lang}/gallery`}
          class="font-cinzel text-sm uppercase tracking-widest px-6 py-3 border border-ragazza-primary text-ragazza-primary hover:bg-ragazza-primary hover:text-white transition-colors duration-300"
        >
          {content.galleryLink}
        </a>
      </nav>

      <!-- WhatsApp CTA -->
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 bg-[#25D366] text-white px-8 py-4 rounded-full font-bold shadow-lg hover:bg-[#128C7E] transition-colors duration-300"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
        </svg>
        {content.whatsappLabel}
      </a>

      <!-- Language Switcher -->
      <div class="mt-12 pt-8 border-t border-ragazza-primary/10">
        <div class="flex items-center justify-center gap-4 text-sm font-lora text-ragazza-secondary/60">
          <span>{lang === 'es' ? 'Ver en:' : 'View in:'}</span>
          <a
            href="/es/"
            class:list={['hover:text-ragazza-primary transition-colors', lang === 'es' && 'text-ragazza-primary font-bold']}
          >
            Español
          </a>
          <span>|</span>
          <a
            href="/en/"
            class:list={['hover:text-ragazza-primary transition-colors', lang === 'en' && 'text-ragazza-primary font-bold']}
          >
            English
          </a>
        </div>
      </div>

    </div>
  </main>
</Layout>
