---
const defaultLocalePath = '/es/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      const preferredLocalePath = (navigator.language || '').toLowerCase().startsWith('en')
        ? '/en/'
        : '/es/';
      window.location.replace(preferredLocalePath);
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${defaultLocalePath}`} />
    </noscript>
  </head>
  <body></body>
</html>
