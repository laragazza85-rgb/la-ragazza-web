---
const redirectsData = await import('../data/es/redirects.json').then((m) => m.default as any);
const redirectData = redirectsData.home;
---

<!doctype html>
<html lang={redirectData.lang}>
<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex,nofollow">
  <meta http-equiv="refresh" content={`0;url=${redirectData.path}`}>
  <link rel="canonical" href={`https://la-ragazza-web.vercel.app${redirectData.path}`}>
  <title>{redirectData.title}</title>
</head>
<body>
  <p>{redirectData.message}</p>
  <script define:vars={{ redirectPath: redirectData.path }}>window.location.href=redirectPath;</script>
</body>
</html>
