---
import AdminLayout from '../../../layouts/AdminLayout.astro';

export const prerender = false;

const localeParam = Astro.params.locale === 'en' ? 'en' : Astro.params.locale === 'es' ? 'es' : null;

if (!localeParam) {
  return Astro.redirect('/admin/contact');
}

type ContactDetail = {
  profile: {
    streetAddress: string;
    city: string;
    state: string;
    country: string;
    mapLink: string;
    wazeLink: string;
    mapEmbedUrl: string;
    latitude: number;
    longitude: number;
    whatsappPhoneNumber: string;
    whatsappMessage: string;
  };
  translation: {
    locationLabel: string;
    familyTitle: string;
    familyFounded: string;
    familyOwners: string;
    familyPhilosophy: string;
    familyCta: string;
    whatsappLabel: string;
    whatsappDescription: string;
    uiTitle: string;
    mapTitle: string;
    mapGoogle: string;
    mapWaze: string;
    mapIframeTitle: string;
    mapOpenAria: string;
    aboutAria: string;
    socialInstagramAria: string;
    socialFacebookAria: string;
  };
};

type ApiResponse = {
  ok: boolean;
  data?: ContactDetail;
  error?: string;
};

const response = await fetch(`${Astro.url.origin}/api/admin/contact/${localeParam}`);
const payload = (await response.json()) as ApiResponse;
const data = payload.data;
---

<AdminLayout title={`Admin | Contact ${localeParam}`}>
  <section class="rounded-xl border border-ragazza-primary/15 bg-white p-6 shadow-sm">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <p class="font-cinzel text-xs uppercase tracking-[0.2em] text-ragazza-accent">Seccion 4</p>
        <h3 class="font-cinzel text-2xl text-ragazza-primary">Editar Contact ({localeParam.toUpperCase()})</h3>
      </div>
      <a href="/admin/contact" class="text-sm text-ragazza-primary underline underline-offset-4">Volver al listado</a>
    </div>

    {!payload.ok || !data ? (
      <p class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        Error cargando contenido: {payload.error ?? 'Registro no encontrado'}
      </p>
    ) : (
      <form id="contact-form" class="space-y-7">
        <input type="hidden" name="localeCode" value={localeParam} />

        <section class="space-y-4 rounded-lg border border-ragazza-primary/10 p-4">
          <h4 class="font-cinzel text-lg text-ragazza-primary">Campos globales (compartidos entre idiomas)</h4>

          <div class="grid gap-4 md:grid-cols-2">
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Street address</span><input name="streetAddress" value={data.profile.streetAddress} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">City</span><input name="city" value={data.profile.city} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">State</span><input name="state" value={data.profile.state} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Country</span><input name="country" value={data.profile.country} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Map link</span><input name="mapLink" value={data.profile.mapLink} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Waze link</span><input name="wazeLink" value={data.profile.wazeLink} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm md:col-span-2"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Map embed URL</span><input name="mapEmbedUrl" value={data.profile.mapEmbedUrl} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Latitude</span><input name="latitude" value={data.profile.latitude} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Longitude</span><input name="longitude" value={data.profile.longitude} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">WhatsApp phone</span><input name="whatsappPhoneNumber" value={data.profile.whatsappPhoneNumber} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">WhatsApp message</span><input name="whatsappMessage" value={data.profile.whatsappMessage} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
          </div>
        </section>

        <section class="space-y-4 rounded-lg border border-ragazza-primary/10 p-4">
          <h4 class="font-cinzel text-lg text-ragazza-primary">Campos traducibles ({localeParam.toUpperCase()})</h4>

          <div class="grid gap-4 md:grid-cols-2">
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Location label</span><input name="locationLabel" value={data.translation.locationLabel} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">UI title</span><input name="uiTitle" value={data.translation.uiTitle} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Family title</span><input name="familyTitle" value={data.translation.familyTitle} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Family founded</span><input name="familyFounded" value={data.translation.familyFounded} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Family owners</span><input name="familyOwners" value={data.translation.familyOwners} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Family philosophy</span><input name="familyPhilosophy" value={data.translation.familyPhilosophy} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Family CTA</span><input name="familyCta" value={data.translation.familyCta} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">WhatsApp label</span><input name="whatsappLabel" value={data.translation.whatsappLabel} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm md:col-span-2"><span class="mb-1 block font-semibold text-ragazza-secondary/80">WhatsApp description</span><input name="whatsappDescription" value={data.translation.whatsappDescription} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Map title</span><input name="mapTitle" value={data.translation.mapTitle} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Map Google label</span><input name="mapGoogle" value={data.translation.mapGoogle} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Map Waze label</span><input name="mapWaze" value={data.translation.mapWaze} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Map iframe title</span><input name="mapIframeTitle" value={data.translation.mapIframeTitle} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Map open aria</span><input name="mapOpenAria" value={data.translation.mapOpenAria} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">About aria</span><input name="aboutAria" value={data.translation.aboutAria} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Instagram aria</span><input name="socialInstagramAria" value={data.translation.socialInstagramAria} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
            <label class="block text-sm"><span class="mb-1 block font-semibold text-ragazza-secondary/80">Facebook aria</span><input name="socialFacebookAria" value={data.translation.socialFacebookAria} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" /></label>
          </div>
        </section>

        <div class="flex items-center gap-3">
          <button type="submit" class="rounded-md bg-ragazza-primary px-4 py-2 font-cinzel text-xs uppercase tracking-widest text-white">
            Guardar cambios
          </button>
          <p id="save-status" class="text-sm text-ragazza-secondary/80"></p>
        </div>
      </form>
    )}
  </section>

  <script>
    const form = document.getElementById('contact-form');
    const status = document.getElementById('save-status');

    if (form instanceof HTMLFormElement && status) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = 'Guardando...';
        status.classList.remove('text-red-700', 'text-green-700');

        const formData = new FormData(form);
        const localeCode = String(formData.get('localeCode') || '').toLowerCase();

        const payload = {
          profile: {
            streetAddress: String(formData.get('streetAddress') || ''),
            city: String(formData.get('city') || ''),
            state: String(formData.get('state') || ''),
            country: String(formData.get('country') || ''),
            mapLink: String(formData.get('mapLink') || ''),
            wazeLink: String(formData.get('wazeLink') || ''),
            mapEmbedUrl: String(formData.get('mapEmbedUrl') || ''),
            latitude: Number(formData.get('latitude') || 0),
            longitude: Number(formData.get('longitude') || 0),
            whatsappPhoneNumber: String(formData.get('whatsappPhoneNumber') || ''),
            whatsappMessage: String(formData.get('whatsappMessage') || ''),
          },
          translation: {
            locationLabel: String(formData.get('locationLabel') || ''),
            familyTitle: String(formData.get('familyTitle') || ''),
            familyFounded: String(formData.get('familyFounded') || ''),
            familyOwners: String(formData.get('familyOwners') || ''),
            familyPhilosophy: String(formData.get('familyPhilosophy') || ''),
            familyCta: String(formData.get('familyCta') || ''),
            whatsappLabel: String(formData.get('whatsappLabel') || ''),
            whatsappDescription: String(formData.get('whatsappDescription') || ''),
            uiTitle: String(formData.get('uiTitle') || ''),
            mapTitle: String(formData.get('mapTitle') || ''),
            mapGoogle: String(formData.get('mapGoogle') || ''),
            mapWaze: String(formData.get('mapWaze') || ''),
            mapIframeTitle: String(formData.get('mapIframeTitle') || ''),
            mapOpenAria: String(formData.get('mapOpenAria') || ''),
            aboutAria: String(formData.get('aboutAria') || ''),
            socialInstagramAria: String(formData.get('socialInstagramAria') || ''),
            socialFacebookAria: String(formData.get('socialFacebookAria') || ''),
          },
        };

        try {
          const response = await fetch(`/api/admin/contact/${localeCode}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (!response.ok) {
            const body = await response.json().catch(() => ({ error: 'Error desconocido' }));
            status.textContent = `Error: ${body.error || 'No se pudo guardar'}`;
            status.classList.add('text-red-700');
            return;
          }

          status.textContent = 'Cambios guardados correctamente';
          status.classList.add('text-green-700');
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Error de red';
          status.classList.add('text-red-700');
        }
      });
    }
  </script>
</AdminLayout>

