---
import AdminLayout from '../../../layouts/AdminLayout.astro';

export const prerender = false;

const localeParam = Astro.params.locale === 'en' ? 'en' : Astro.params.locale === 'es' ? 'es' : null;

if (!localeParam) {
  return Astro.redirect('/admin/home');
}

type HomeTranslation = {
  localeCode: 'es' | 'en';
  title: string;
  subtitle: string;
  philosophy: string;
  viewMenuText: string;
  reserveTableText: string;
  homeSeoHeading: string;
  homeSeoParagraphOne: string;
  homeSeoParagraphTwo: string;
  p3BeforeMenuLink: string;
  p3MenuLinkText: string;
  p3BetweenLinks: string;
  p3ReserveLinkText: string;
  p3AfterReserveLink: string;
  essenceTitleHtml: string;
  essenceDescription: string;
  essenceCtaText: string;
  essenceCtaLink: string;
};

type ApiResponse = {
  ok: boolean;
  data?: HomeTranslation;
  error?: string;
};

const response = await fetch(`${Astro.url.origin}/api/admin/home/${localeParam}`);
const payload = (await response.json()) as ApiResponse;
const data = payload.data;
---

<AdminLayout title={`Admin | Home ${localeParam}`}>
  <section class="rounded-xl border border-ragazza-primary/15 bg-white p-6 shadow-sm">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <p class="font-cinzel text-xs uppercase tracking-[0.2em] text-ragazza-accent">Seccion 2</p>
        <h3 class="font-cinzel text-2xl text-ragazza-primary">Editar Home ({localeParam.toUpperCase()})</h3>
      </div>
      <a href="/admin/home" class="text-sm text-ragazza-primary underline underline-offset-4">Volver al listado</a>
    </div>

    {!payload.ok || !data ? (
      <p class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        Error cargando contenido: {payload.error ?? 'Registro no encontrado'}
      </p>
    ) : (
      <form id="home-translation-form" class="space-y-5">
        <input type="hidden" name="localeCode" value={localeParam} />

        <div class="grid gap-4 md:grid-cols-2">
          <label class="block text-sm">
            <span class="mb-1 block font-semibold text-ragazza-secondary/80">Title</span>
            <input name="title" value={data.title} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" />
          </label>

          <label class="block text-sm">
            <span class="mb-1 block font-semibold text-ragazza-secondary/80">Subtitle</span>
            <input name="subtitle" value={data.subtitle} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" />
          </label>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
          <label class="block text-sm">
            <span class="mb-1 block font-semibold text-ragazza-secondary/80">Philosophy</span>
            <input name="philosophy" value={data.philosophy} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" />
          </label>
          <label class="block text-sm">
            <span class="mb-1 block font-semibold text-ragazza-secondary/80">View Menu Text</span>
            <input name="viewMenuText" value={data.viewMenuText} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" />
          </label>
          <label class="block text-sm">
            <span class="mb-1 block font-semibold text-ragazza-secondary/80">Reserve Table Text</span>
            <input name="reserveTableText" value={data.reserveTableText} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" />
          </label>
        </div>

        <label class="block text-sm">
          <span class="mb-1 block font-semibold text-ragazza-secondary/80">Home SEO Heading</span>
          <input name="homeSeoHeading" value={data.homeSeoHeading} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" />
        </label>

        <label class="block text-sm">
          <span class="mb-1 block font-semibold text-ragazza-secondary/80">Paragraph One</span>
          <textarea name="homeSeoParagraphOne" rows="4" class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2">{data.homeSeoParagraphOne}</textarea>
        </label>

        <label class="block text-sm">
          <span class="mb-1 block font-semibold text-ragazza-secondary/80">Paragraph Two</span>
          <textarea name="homeSeoParagraphTwo" rows="4" class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2">{data.homeSeoParagraphTwo}</textarea>
        </label>

        <div class="grid gap-4 md:grid-cols-2">
          <label class="block text-sm">
            <span class="mb-1 block font-semibold text-ragazza-secondary/80">P3 Before Menu Link</span>
            <textarea name="p3BeforeMenuLink" rows="3" class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2">{data.p3BeforeMenuLink}</textarea>
          </label>
          <label class="block text-sm">
            <span class="mb-1 block font-semibold text-ragazza-secondary/80">P3 Menu Link Text</span>
            <input name="p3MenuLinkText" value={data.p3MenuLinkText} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" />
          </label>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
          <label class="block text-sm">
            <span class="mb-1 block font-semibold text-ragazza-secondary/80">P3 Between Links</span>
            <input name="p3BetweenLinks" value={data.p3BetweenLinks} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" />
          </label>
          <label class="block text-sm">
            <span class="mb-1 block font-semibold text-ragazza-secondary/80">P3 Reserve Link Text</span>
            <input name="p3ReserveLinkText" value={data.p3ReserveLinkText} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" />
          </label>
          <label class="block text-sm">
            <span class="mb-1 block font-semibold text-ragazza-secondary/80">P3 After Reserve Link</span>
            <input name="p3AfterReserveLink" value={data.p3AfterReserveLink} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" />
          </label>
        </div>

        <label class="block text-sm">
          <span class="mb-1 block font-semibold text-ragazza-secondary/80">Essence Title HTML</span>
          <input name="essenceTitleHtml" value={data.essenceTitleHtml} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" />
        </label>

        <label class="block text-sm">
          <span class="mb-1 block font-semibold text-ragazza-secondary/80">Essence Description</span>
          <textarea name="essenceDescription" rows="4" class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2">{data.essenceDescription}</textarea>
        </label>

        <div class="grid gap-4 md:grid-cols-2">
          <label class="block text-sm">
            <span class="mb-1 block font-semibold text-ragazza-secondary/80">Essence CTA Text</span>
            <input name="essenceCtaText" value={data.essenceCtaText} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" />
          </label>
          <label class="block text-sm">
            <span class="mb-1 block font-semibold text-ragazza-secondary/80">Essence CTA Link</span>
            <input name="essenceCtaLink" value={data.essenceCtaLink} class="w-full rounded-md border border-ragazza-primary/20 px-3 py-2" />
          </label>
        </div>

        <div class="flex items-center gap-3">
          <button type="submit" class="rounded-md bg-ragazza-primary px-4 py-2 font-cinzel text-xs uppercase tracking-widest text-white">
            Guardar cambios
          </button>
          <p id="save-status" class="text-sm text-ragazza-secondary/80"></p>
        </div>
      </form>
    )}
  </section>

  <script>
    const form = document.getElementById('home-translation-form');
    const status = document.getElementById('save-status');

    if (form instanceof HTMLFormElement && status) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = 'Guardando...';

        const formData = new FormData(form);
        const localeCode = String(formData.get('localeCode') || '').toLowerCase();

        const payload = {
          title: String(formData.get('title') || ''),
          subtitle: String(formData.get('subtitle') || ''),
          philosophy: String(formData.get('philosophy') || ''),
          viewMenuText: String(formData.get('viewMenuText') || ''),
          reserveTableText: String(formData.get('reserveTableText') || ''),
          homeSeoHeading: String(formData.get('homeSeoHeading') || ''),
          homeSeoParagraphOne: String(formData.get('homeSeoParagraphOne') || ''),
          homeSeoParagraphTwo: String(formData.get('homeSeoParagraphTwo') || ''),
          p3BeforeMenuLink: String(formData.get('p3BeforeMenuLink') || ''),
          p3MenuLinkText: String(formData.get('p3MenuLinkText') || ''),
          p3BetweenLinks: String(formData.get('p3BetweenLinks') || ''),
          p3ReserveLinkText: String(formData.get('p3ReserveLinkText') || ''),
          p3AfterReserveLink: String(formData.get('p3AfterReserveLink') || ''),
          essenceTitleHtml: String(formData.get('essenceTitleHtml') || ''),
          essenceDescription: String(formData.get('essenceDescription') || ''),
          essenceCtaText: String(formData.get('essenceCtaText') || ''),
          essenceCtaLink: String(formData.get('essenceCtaLink') || ''),
        };

        try {
          const response = await fetch(`/api/admin/home/${localeCode}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (!response.ok) {
            const data = await response.json().catch(() => ({ error: 'Error desconocido' }));
            status.textContent = `Error: ${data.error || 'No se pudo guardar'}`;
            status.classList.add('text-red-700');
            return;
          }

          status.textContent = 'Cambios guardados correctamente';
          status.classList.remove('text-red-700');
          status.classList.add('text-green-700');
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Error de red';
          status.classList.add('text-red-700');
        }
      });
    }
  </script>
</AdminLayout>

