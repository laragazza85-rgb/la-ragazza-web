---
import AdminLayout from '../../layouts/AdminLayout.astro';

type HealthResponse = {
  ok: boolean;
  service: string;
  db: 'up' | 'down';
  latencyMs: number;
  timestamp: string;
  error?: string;
};

const baseUrl = Astro.url.origin;
const health = (await fetch(`${baseUrl}/api/admin/health`).then((res) => res.json())) as HealthResponse;
---

<AdminLayout title="Admin Dashboard | La Ragazza">
  <section class="grid gap-4 md:grid-cols-3">
    <article class="rounded-xl border border-ragazza-primary/15 bg-white p-5 shadow-sm">
      <p class="font-cinzel text-xs uppercase tracking-[0.2em] text-ragazza-accent">Database</p>
      <p class="mt-2 font-cinzel text-2xl text-ragazza-primary">{health.db === 'up' ? 'Conectada' : 'Sin conexion'}</p>
      <p class="mt-2 text-sm text-ragazza-secondary/70">Latencia: {health.latencyMs} ms</p>
    </article>

    <article class="rounded-xl border border-ragazza-primary/15 bg-white p-5 shadow-sm">
      <p class="font-cinzel text-xs uppercase tracking-[0.2em] text-ragazza-accent">API</p>
      <p class="mt-2 font-cinzel text-2xl text-ragazza-primary">{health.ok ? 'Operativa' : 'Degradada'}</p>
      <p class="mt-2 text-sm text-ragazza-secondary/70">Servicio: {health.service}</p>
    </article>

    <article class="rounded-xl border border-ragazza-primary/15 bg-white p-5 shadow-sm">
      <p class="font-cinzel text-xs uppercase tracking-[0.2em] text-ragazza-accent">Ultima revision</p>
      <p class="mt-2 text-sm text-ragazza-secondary/80">{new Date(health.timestamp).toLocaleString('es-CO')}</p>
      {health.error && <p class="mt-3 text-sm text-red-700">{health.error}</p>}
    </article>
  </section>

  <section class="mt-8 grid gap-4 md:grid-cols-2">
    <article class="rounded-xl border border-ragazza-primary/15 bg-white p-6 shadow-sm">
      <h3 class="font-cinzel text-xl text-ragazza-primary">Seccion 2: Home</h3>
      <p class="mt-3 text-ragazza-secondary/80">Gestion de `home_page_translation` por idioma.</p>
      <a href="/admin/home" class="mt-4 inline-flex rounded-md border border-ragazza-primary/30 px-4 py-2 text-sm font-semibold text-ragazza-primary hover:bg-ragazza-primary hover:text-white">
        Ir al modulo Home
      </a>
    </article>

    <article class="rounded-xl border border-ragazza-primary/15 bg-white p-6 shadow-sm">
      <h3 class="font-cinzel text-xl text-ragazza-primary">Seccion 3: About</h3>
      <p class="mt-3 text-ragazza-secondary/80">Gestion de `about_page_translation`, personas y parrafos ordenados.</p>
      <a href="/admin/about" class="mt-4 inline-flex rounded-md border border-ragazza-primary/30 px-4 py-2 text-sm font-semibold text-ragazza-primary hover:bg-ragazza-primary hover:text-white">
        Ir al modulo About
      </a>
    </article>
  </section>
</AdminLayout>

