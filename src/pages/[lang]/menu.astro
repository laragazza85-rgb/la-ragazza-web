---
// src/pages/[lang]/menu.astro
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/sections/Contact.astro';
import Footer from '../../components/ui/Footer.astro';
import MenuSection from '../../components/sections/MenuSection.astro';

export function getStaticPaths() {
    return [
        { params: { lang: 'es' } },
        { params: { lang: 'en' } }
    ];
}

const { lang } = Astro.params;

// Importar datos del menú
const menuData = await import(`../../data/${lang}/menu.json`).then(m => m.default);
---

<Layout
        title={lang === 'es'
            ? 'Menú | La Ragazza Ristorante'
            : 'Menu | La Ragazza Ristorante'}
        description={lang === 'es'
            ? 'Descubre nuestro menú de auténtica cocina italiana: lasañas, pastas, carnes y postres preparados diariamente de forma casera.'
            : 'Discover our menu of authentic Italian cuisine: lasagnas, pastas, meats and desserts prepared daily in a homemade style.'}
        solidBg={true}
>
    {/* Menu Header */}
    <div class="pt-40 pb-20 bg-ragazza-bg text-center px-4 relative overflow-hidden">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-ragazza-primary/5 rounded-full blur-3xl -z-10"></div>
        <span class="font-cinzel text-ragazza-accent tracking-widest text-sm uppercase font-bold reveal opacity-0 translate-y-8 transition-all duration-1000">
            {lang === 'es' ? 'Nuestras Recetas' : 'Our Recipes'}
        </span>
        <h1 class="font-cinzel text-5xl md:text-7xl text-ragazza-dark mt-4 mb-6 reveal opacity-0 translate-y-8 transition-all duration-1000 delay-100">
            {lang === 'es' ? 'Menú' : 'Menu'}
        </h1>
        <div class="w-16 h-[2px] bg-ragazza-accent mx-auto mt-8 mb-8 reveal opacity-0 translate-y-8 transition-all duration-1000 delay-200"></div>
        <p class="font-lora text-ragazza-secondary/80 max-w-2xl mx-auto italic reveal opacity-0 translate-y-8 transition-all duration-1000 delay-300">
            {lang === 'es'
                ? 'Cada plato cuenta la historia de la tradición italiana en los Llanos. Todo hecho a mano, sin prisas.'
                : 'Each dish tells the story of Italian tradition in the Llanos. Everything handmade, unhurried.'}
        </p>
    </div>

    {/* Menu Sections */}
    <main class="bg-ragazza-bg pb-24">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            {menuData.map((section: any) => (
                <MenuSection category={section} lang={lang} />
            ))}
        </div>
    </main>

    <Contact lang={lang} />
    <Footer lang={lang} />
</Layout>
