---
// src/pages/[lang]/menu.astro
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/sections/Contact.astro';
import Footer from '../../components/ui/Footer.astro';
import MenuSection from '../../components/sections/MenuSection.astro';
import { getMenuData, getMenuPageData } from '../../lib/i18n-data';

export function getStaticPaths() {
    return [
        { params: { lang: 'es' } },
        { params: { lang: 'en' } }
    ];
}

const { lang } = Astro.params;
const menuData = getMenuData(lang as 'es' | 'en') as Array<{ id: string; title: string; description?: string; items: Array<{ name: string; description?: string; price: number; isVegetarian?: boolean; sauceOptions?: string[]; notes?: string }> }>;
const menuPageData = getMenuPageData(lang as 'es' | 'en');
const filterLabels = menuPageData.filters;
---

<Layout
        title={menuPageData.seo.title}
        description={menuPageData.seo.description}
        solidBg={true}
    >
    {/* Menu Header */}
    <div class="pt-40 pb-20 bg-ragazza-bg text-center px-4 relative overflow-hidden">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-ragazza-primary/5 rounded-full blur-3xl -z-10"></div>
        <span class="font-cinzel text-ragazza-accent tracking-widest text-sm uppercase font-bold reveal opacity-0 translate-y-8 transition-all duration-1000">
            {menuPageData.header.label}
        </span>
        <h1 class="font-cinzel text-5xl md:text-7xl text-ragazza-ink mt-4 mb-6 reveal opacity-0 translate-y-8 transition-all duration-1000 delay-100">
            {menuPageData.header.title}
        </h1>
        <div class="sauce-line mx-auto mt-8 mb-8 reveal opacity-0 translate-y-8 transition-all duration-1000 delay-200"></div>
        <p class="font-lora text-ragazza-secondary/80 dark:text-ragazza-ink/70 max-w-2xl mx-auto italic reveal opacity-0 translate-y-8 transition-all duration-1000 delay-300">
            {menuPageData.header.description}
        </p>
    </div>

    {/* Menu Sections */}
    <main class="bg-ragazza-bg pb-24">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-10 flex flex-wrap items-center gap-2 sm:gap-3 justify-center sm:justify-start" id="menu-filters">
                <button type="button" data-filter="all" class="menu-filter-btn btn-elegant border border-ragazza-primary/30 dark:border-white/30 bg-ragazza-primary text-white px-3 py-2 font-cinzel text-xs uppercase tracking-widest transition-colors">{filterLabels.all}</button>
                <button type="button" data-filter="vegetarian" class="menu-filter-btn btn-elegant border border-ragazza-primary/30 dark:border-white/30 text-ragazza-primary dark:text-ragazza-ink px-3 py-2 font-cinzel text-xs uppercase tracking-widest hover:bg-ragazza-primary hover:text-white transition-colors">{filterLabels.vegetarian}</button>
                <button type="button" data-filter="pastas" class="menu-filter-btn btn-elegant border border-ragazza-primary/30 dark:border-white/30 text-ragazza-primary dark:text-ragazza-ink px-3 py-2 font-cinzel text-xs uppercase tracking-widest hover:bg-ragazza-primary hover:text-white transition-colors">{filterLabels.pastas}</button>
                <button type="button" data-filter="wines" class="menu-filter-btn btn-elegant border border-ragazza-primary/30 dark:border-white/30 text-ragazza-primary dark:text-ragazza-ink px-3 py-2 font-cinzel text-xs uppercase tracking-widest hover:bg-ragazza-primary hover:text-white transition-colors">{filterLabels.wines}</button>
                <button type="button" data-filter="desserts" class="menu-filter-btn btn-elegant border border-ragazza-primary/30 dark:border-white/30 text-ragazza-primary dark:text-ragazza-ink px-3 py-2 font-cinzel text-xs uppercase tracking-widest hover:bg-ragazza-primary hover:text-white transition-colors">{filterLabels.desserts}</button>
                <button type="button" data-filter="drinks" class="menu-filter-btn btn-elegant border border-ragazza-primary/30 dark:border-white/30 text-ragazza-primary dark:text-ragazza-ink px-3 py-2 font-cinzel text-xs uppercase tracking-widest hover:bg-ragazza-primary hover:text-white transition-colors">{filterLabels.drinks}</button>
            </div>

            {menuData.map((section: any) => (
                <MenuSection category={section} lang={lang} />
            ))}
        </div>
    </main>

    <Contact lang={lang} />
    <Footer lang={lang} />
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        type FilterKey = 'all' | 'vegetarian' | 'pastas' | 'wines' | 'desserts' | 'drinks';

        const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.menu-filter-btn'));
        const sections = Array.from(document.querySelectorAll<HTMLElement>('.menu-category-section'));

        const categoryGroups: Record<Exclude<FilterKey, 'all' | 'vegetarian'>, string[]> = {
            pastas: ['lasagna', 'spaguetti-tallarin', 'ravioli', 'caneloni'],
            wines: ['vinos'],
            desserts: ['postres'],
            drinks: ['bebidas-sin-alcohol', 'bebidas-con-alcohol'],
        };

        const setActiveButton = (filter: FilterKey) => {
            buttons.forEach((button) => {
                const isActive = button.dataset.filter === filter;
                button.classList.toggle('bg-ragazza-primary', isActive);
                button.classList.toggle('text-white', isActive);
                button.classList.toggle('text-ragazza-primary', !isActive);
                button.classList.toggle('dark:text-ragazza-ink', !isActive);
            });
        };

        const applyFilter = (filter: FilterKey) => {
            sections.forEach((section) => {
                const categoryId = section.dataset.menuCategory || '';
                const items = Array.from(section.querySelectorAll<HTMLElement>('[data-menu-item]'));

                items.forEach((item) => {
                    item.classList.remove('hidden');
                });

                let sectionVisible = true;

                if (filter === 'vegetarian') {
                    items.forEach((item) => {
                        const isVegetarian = item.dataset.vegetarian === 'true';
                        item.classList.toggle('hidden', !isVegetarian);
                    });
                    sectionVisible = items.some((item) => item.dataset.vegetarian === 'true');
                } else if (filter !== 'all') {
                    sectionVisible = categoryGroups[filter].includes(categoryId);
                }

                section.classList.toggle('hidden', !sectionVisible);
            });
        };

        buttons.forEach((button) => {
            button.addEventListener('click', () => {
                const filter = (button.dataset.filter as FilterKey | undefined) || 'all';
                setActiveButton(filter);
                applyFilter(filter);
            });
        });
    });
</script>
