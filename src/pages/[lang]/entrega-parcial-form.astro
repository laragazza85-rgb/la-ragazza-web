---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/ui/Footer.astro';
import PartialContactForm from '../../components/sections/PartialContactForm.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: 'es' | 'en' };

const title =
  lang === 'es'
    ? 'Formulario de contacto | Entrega parcial | La Ragazza'
    : 'Contact form | Partial delivery | La Ragazza';

const description =
  lang === 'es'
    ? 'Formulario de contacto para entrega parcial con validaciones de nombre, email, telefono, tipo de consulta y mensaje.'
    : 'Contact form for partial delivery with validations for name, email, phone, inquiry type, and message.';
---

<Layout title={title} description={description} solidBg={true}>
  <main>
    <PartialContactForm lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

