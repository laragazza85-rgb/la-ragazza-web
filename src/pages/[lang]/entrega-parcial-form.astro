---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/ui/Footer.astro';
import PartialContactForm from '../../components/sections/PartialContactForm.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: 'es' | 'en' };
const formData = await import(`../../data/${lang}/partial-form.json`).then((m) => m.default);
---

<Layout title={formData.seo.title} description={formData.seo.description} solidBg={true}>
  <main>
    <PartialContactForm lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

