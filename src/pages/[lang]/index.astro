---
// src/pages/[lang]/index.astro
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/sections/Hero.astro';
import Contact from '../../components/sections/Contact.astro';
import Footer from '../../components/ui/Footer.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import { getHeroData, getReviewsData } from '../../lib/i18n-data';

export function getStaticPaths() {
    return [
        { params: { lang: 'es' } },
        { params: { lang: 'en' } }
    ];
}

const { lang } = Astro.params;
const heroData = getHeroData(lang as 'es' | 'en');
const reviewsData = getReviewsData() as { reviews: { text_es: string; text_en: string }[] };
const allReviews = reviewsData.reviews;
const shuffled = allReviews.sort(() => Math.random() - 0.5);
const randomReviews = shuffled.slice(0, 3);
---

<Layout
        title={heroData.seo.title}
        description={heroData.seo.description}
>
    <main>
        <Hero lang={lang} />

        {/* New SEO Content Section */}
        <section class="pt-12 sm:pt-16 pb-16 bg-white dark:bg-ragazza-surface px-4 sm:px-6 lg:px-8">
            <div class="max-w-4xl mx-auto">
                <article class="prose prose-lg max-w-none">
                    <h2 class="font-cinzel text-3xl text-ragazza-primary dark:text-ragazza-ink mb-6">{heroData.homeSeoSection.heading}</h2>

                    <p class="mb-4 text-ragazza-secondary/90 dark:text-ragazza-ink/80 leading-relaxed">
                        {heroData.homeSeoSection.paragraphOne}
                    </p>

                    <p class="mb-4 text-ragazza-secondary/90 dark:text-ragazza-ink/80 leading-relaxed">
                        {heroData.homeSeoSection.paragraphTwo}
                    </p>

                    <p class="mb-4 text-ragazza-secondary/90 dark:text-ragazza-ink/80 leading-relaxed">
                        {heroData.homeSeoSection.paragraphThree.beforeMenuLink}{' '}
                        <a href={`/${lang}/menu`} class="text-ragazza-primary dark:text-ragazza-ink hover:text-ragazza-accent font-semibold">{heroData.homeSeoSection.paragraphThree.menuLinkText}</a>{' '}
                        {heroData.homeSeoSection.paragraphThree.betweenLinks}{' '}
                        <a href="#contact" class="text-ragazza-primary dark:text-ragazza-ink hover:text-ragazza-accent font-semibold">{heroData.homeSeoSection.paragraphThree.reserveLinkText}</a>{' '}
                        {heroData.homeSeoSection.paragraphThree.afterReserveLink}
                    </p>
                </article>
            </div>
        </section>

        {/* Section: The Essence (Initial Storytelling) */}
        <section class="py-24 bg-ragazza-bg px-4 sm:px-6 lg:px-8 text-center reveal opacity-0 translate-y-8 transition-all duration-300">
            <div class="max-w-3xl mx-auto">
                <svg class="w-8 h-8 mx-auto text-ragazza-accent mb-6 opacity-80" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
                <h2 class="font-cinzel text-3xl md:text-5xl text-ragazza-primary dark:text-ragazza-ink leading-tight mb-8">
                    <Fragment set:html={heroData.essence.title} />
                </h2>
                <p class="font-lora text-lg md:text-xl text-ragazza-secondary/80 dark:text-ragazza-ink/70 italic leading-relaxed">
                    {heroData.essence.description}
                </p>
                <a href={heroData.essence.ctaLink} class="link-elegant inline-block mt-10 font-cinzel text-sm text-ragazza-primary dark:text-ragazza-ink font-bold uppercase tracking-widest border-b border-ragazza-primary dark:border-white/50 pb-1 hover:text-ragazza-accent hover:border-ragazza-accent">
                    {heroData.essence.ctaText}
                </a>
            </div>
        </section>

        {/* Section: Editorial Navigation Cards */}
        <section class="py-12 bg-ragazza-bg pb-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

                    {/* Card 1: Menu */}
                    <a href={`/${lang}/menu`} class="group relative h-[450px] overflow-hidden reveal opacity-0 translate-y-8 transition-all duration-300">
                        <div class="absolute inset-0 bg-ragazza-primary/20 transition-all duration-200 group-hover:bg-ragazza-dark/40 z-10"></div>
                        <div class="absolute inset-0 bg-ragazza-secondary transition-transform duration-200 group-hover:scale-105"></div>
                        <div class="absolute inset-0 z-20 flex flex-col items-center justify-center p-8 text-center border border-white/20 m-4">
                            <h3 class="font-cinzel text-3xl text-white mb-2">{heroData.cards.menu.title}</h3>
                            <p class="font-lora text-white/80 italic">{heroData.cards.menu.subtitle}</p>
                        </div>
                    </a>

                    {/* Card 2: Gallery */}
                    <a href={`/${lang}/gallery`} class="group relative h-[450px] overflow-hidden reveal opacity-0 translate-y-8 transition-all duration-300 delay-100">
                        <div class="absolute inset-0 bg-ragazza-accent/20 transition-all duration-200 group-hover:bg-ragazza-dark/40 z-10"></div>
                        <div class="absolute inset-0 bg-ragazza-primary transition-transform duration-200 group-hover:scale-105"></div>
                        <div class="absolute inset-0 z-20 flex flex-col items-center justify-center p-8 text-center border border-white/20 m-4">
                            <h3 class="font-cinzel text-3xl text-white mb-2">{heroData.cards.gallery.title}</h3>
                            <p class="font-lora text-white/80 italic">{heroData.cards.gallery.subtitle}</p>
                        </div>
                    </a>

                    {/* Card 3: Reservations */}
                    <a href="#contact" class="group relative h-[450px] overflow-hidden md:col-span-2 lg:col-span-1 reveal opacity-0 translate-y-8 transition-all duration-300 delay-200">
                        <div class="absolute inset-0 bg-ragazza-dark/20 transition-all duration-200 group-hover:bg-ragazza-dark/60 z-10"></div>
                        <div class="absolute inset-0 bg-[#4a1f1f] transition-transform duration-200 group-hover:scale-105"></div>
                        <div class="absolute inset-0 z-20 flex flex-col items-center justify-center p-8 text-center border border-white/20 m-4">
                            <h3 class="font-cinzel text-3xl text-white mb-2">{heroData.cards.reservations.title}</h3>
                            <p class="font-lora text-white/80 italic">{heroData.cards.reservations.subtitle}</p>
                        </div>
                    </a>

                </div>
            </div>
        </section>

        {/* Section: Why Choose Us */}
        <section id="porque-elegirnos" aria-labelledby="porque-elegirnos-heading" class="py-24 bg-white dark:bg-ragazza-surface px-4 sm:px-6 lg:px-8">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-16">
                    <span class="font-cinzel text-ragazza-accent tracking-widest text-sm uppercase font-bold">La diferencia La Ragazza</span>
                    <h2 id="porque-elegirnos-heading" class="font-cinzel text-4xl md:text-5xl text-ragazza-primary dark:text-ragazza-ink mt-4">
                        {lang === 'es' ? 'Por qué elegirnos' : 'Why choose us'}
                    </h2>
                    <div class="sauce-line mx-auto mt-6"></div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    {heroData.homeSeoSection.whyChooseUs.map((item: { title: string; description: string }, index: number) => (
                        <article class="text-center reveal opacity-0 translate-y-8 transition-all duration-300" style={`animation-delay: ${index * 100}ms`}>
                            <div class="w-16 h-16 mx-auto mb-6 bg-ragazza-bg dark:bg-ragazza-surface-raised rounded-full flex items-center justify-center">
                                <svg class="w-8 h-8 text-ragazza-primary dark:text-ragazza-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                    {index === 0 && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />}
                                    {index === 1 && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />}
                                    {index === 2 && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />}
                                    {index === 3 && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />}
                                </svg>
                            </div>
                            <h3 class="font-cinzel text-xl text-ragazza-ink mb-3">{item.title}</h3>
                            <p class="font-lora text-ragazza-secondary/80 dark:text-ragazza-ink/70 text-sm leading-relaxed">{item.description}</p>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        {/* Section: Testimonials */}
        <section id="testimonios" aria-labelledby="testimonios-heading" class="py-24 bg-ragazza-bg px-4 sm:px-6 lg:px-8">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-16">
                    <span class="font-cinzel text-ragazza-accent tracking-widest text-sm uppercase font-bold">
                        {lang === 'es' ? 'Lo que dicen nuestros clientes' : 'What our clients say'}
                    </span>
                    <h2 id="testimonios-heading" class="font-cinzel text-4xl md:text-5xl text-ragazza-primary dark:text-ragazza-ink mt-4">
                        {lang === 'es' ? 'Testimonios' : 'Testimonials'}
                    </h2>
                    <div class="sauce-line mx-auto mt-6"></div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {randomReviews.map((review: { text_es: string; text_en: string }, index: number) => (
                        <article class="bg-white dark:bg-ragazza-surface p-8 rounded-lg shadow-sm border border-ragazza-primary/10 dark:border-white/10 reveal opacity-0 translate-y-8 transition-all duration-300" style={`animation-delay: ${index * 100}ms`}>
                            <svg class="w-8 h-8 text-ragazza-accent/40 mb-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                            </svg>
                            <blockquote class="font-lora text-ragazza-secondary/90 dark:text-ragazza-ink/80 italic leading-relaxed">"{lang === 'es' ? review.text_es : review.text_en}"</blockquote>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <FaqSection lang={lang} />
        <Contact lang={lang} />
    </main>
    <Footer lang={lang} />
</Layout>

