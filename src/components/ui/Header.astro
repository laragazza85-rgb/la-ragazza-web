---
// src/components/ui/Header.astro
import { useTranslations } from '../../i18n/utils';
import { ui } from '../../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
    lang?: string;
    solidBg?: boolean;
}

const lang = (Astro.props.lang || 'es') as 'es' | 'en';
const t = useTranslations(lang);
const solidBg = Astro.props.solidBg ?? false;
const labelsData = await import(`../../data/${lang}/labels.json`).then(m => m.default);

const navItems = [
    { name: t('nav.home'), path: `/${lang}/` },
    { name: t('nav.about'), path: `/${lang}/about` },
    { name: t('nav.menu'), path: `/${lang}/menu` },
    { name: t('nav.gallery'), path: `/${lang}/gallery` },
];
---

<header
        id="main-header"
        class="fixed w-full top-0 z-50 transition-all duration-500 border-b text-white border-white/10 bg-ragazza-dark"
>
    <div class="w-full px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20 sm:h-24 md:h-28 transition-all duration-500" id="header-container">

            {/* Logo Tipográfico */}
            <a href={`/${lang}/`} class="font-cinzel text-2xl sm:text-3xl md:text-4xl font-bold tracking-widest z-50 hover:text-ragazza-accent transition-colors whitespace-nowrap">
                LA RAGAZZA
            </a>

            {/* Menú Desktop */}
            <nav class="hidden md:flex space-x-10">
                {navItems.map(item => (
                        <a href={item.path} class="font-cinzel text-sm uppercase tracking-widest hover:text-ragazza-accent transition-colors relative group">
                            {item.name}
                            <span class="absolute -bottom-2 left-0 w-0 h-[1px] bg-ragazza-accent transition-all duration-300 group-hover:w-full"></span>
                        </a>
                ))}
            </nav>

            {/* Botón CTA y Hamburguesa Mobile */}
            <div class="flex items-center gap-6 z-50">
                <a href="#contact" class="hidden md:inline-flex border border-white/50 px-6 py-2.5 font-cinzel text-xs uppercase tracking-widest hover:bg-white hover:text-ragazza-primary transition-all duration-300">
                    {labelsData.header.reserve}
                </a>

                <div class="hidden md:block">
                    <LanguageSwitcher lang={lang} />
                </div>

                <button id="mobile-menu-btn" class="md:hidden p-2 text-white hover:text-ragazza-accent transition-colors" aria-label="Menu">
                    <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
            </div>

        </div>
    </div>

    {/* Menú Mobile Desplegable */}
    <div id="mobile-menu" class="md:hidden fixed inset-0 top-20 sm:top-24 bg-ragazza-secondary/95 backdrop-blur-md max-h-screen overflow-y-auto z-40 translate-y-full transition-transform duration-500">
        <nav class="flex flex-col px-6 py-8">
            {navItems.map(item => (
                    <a href={item.path} class="font-cinzel text-2xl sm:text-3xl uppercase tracking-widest text-white border-b border-white/10 py-6 hover:text-ragazza-accent transition-colors">
                        {item.name}
                    </a>
            ))}

            {/* Language Switcher y Reserve Button en el menú móvil */}
            <div class="pt-8 pb-4 flex justify-between items-center">
                <a href="#contact" class="border border-white/50 px-4 py-2 font-cinzel text-xs uppercase tracking-widest hover:bg-white hover:text-ragazza-primary transition-all duration-300 text-white">
                    {labelsData.header.reserve}
                </a>
                <LanguageSwitcher lang={lang} />
            </div>
        </nav>
    </div>
</header>

<script define:vars={{ solidBg }}>
    document.addEventListener('DOMContentLoaded', () => {
        const header = document.getElementById('main-header');
        const headerContainer = document.getElementById('header-container');
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        let isMenuOpen = false;

        const closeMenu = () => {
            if (isMenuOpen) {
                isMenuOpen = false;
                mobileMenu?.classList.add('translate-y-full');
                mobileMenu?.classList.remove('translate-y-0');
                mobileBtn.innerHTML = '<svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>';
            }
        };

        const isDesktop = () => window.innerWidth >= 768;

        const applyHeaderState = () => {
            const scrolled = window.scrollY > 50;

            if (isDesktop()) {
                if (scrolled) {
                    headerContainer?.classList.remove('md:h-28');
                    headerContainer?.classList.add('md:h-24');
                } else {
                    headerContainer?.classList.add('md:h-28');
                    headerContainer?.classList.remove('md:h-24');
                }
                return;
            }

            // Mobile
            if (scrolled) {
                header?.classList.add('backdrop-blur-md');
            } else {
                header?.classList.remove('backdrop-blur-md');
            }
        };

        applyHeaderState();

        window.addEventListener('scroll', () => {
            applyHeaderState();
            closeMenu();
        });

        window.addEventListener('resize', applyHeaderState);

        mobileBtn?.addEventListener('click', () => {
            isMenuOpen = !isMenuOpen;
            if (isMenuOpen) {
                mobileMenu?.classList.remove('translate-y-full');
                mobileMenu?.classList.add('translate-y-0');
                mobileBtn.innerHTML = '<svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>';
            } else {
                closeMenu();
            }
        });

        mobileMenu?.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', closeMenu);
        });
    });
</script>