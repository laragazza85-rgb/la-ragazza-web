---
// src/components/ui/Header.astro
import { useTranslations } from '../../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLabelsData } from '../../lib/i18n-data';

interface Props {
    lang?: string;
    solidBg?: boolean;
}

const lang = (Astro.props.lang || 'es') as 'es' | 'en';
const t = useTranslations(lang);
const labelsData = getLabelsData(lang) as { brand: { name: string }; header: { mobileMenuAria: string; reserve: string } };

const navItems = [
    { name: t('nav.home'), path: `/${lang}/` },
    { name: t('nav.about'), path: `/${lang}/about` },
    { name: t('nav.menu'), path: `/${lang}/menu` },
    { name: t('nav.gallery'), path: `/${lang}/gallery` },
];
---

<header
        id="main-header"
        class="fixed w-full top-0 z-50 transition-all duration-300 border-b text-white border-white/10 bg-ragazza-dark"
>
    <div class="w-full px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20 sm:h-24 lg:h-28 transition-all duration-300" id="header-container">

            {/* Logo Tipográfico */}
            <a href={`/${lang}/`} class="font-cinzel text-2xl sm:text-3xl lg:text-4xl font-bold tracking-widest z-50 hover:opacity-70 transition-opacity whitespace-nowrap">
                {labelsData.brand.name}
            </a>

            {/* Menú Desktop */}
            <nav class="hidden lg:flex space-x-10">
                {navItems.map(item => (
                        <a href={item.path} class="font-cinzel text-sm uppercase tracking-widest hover:opacity-70 transition-opacity duration-200 relative group">
                            {item.name}
                            <span class="absolute -bottom-2 left-0 w-0 h-[1px] bg-ragazza-accent transition-all duration-200 ease-out group-hover:w-full"></span>
                        </a>
                ))}
            </nav>

            {/* Botón CTA y Hamburguesa Mobile */}
            <div class="flex items-center gap-6 z-50">
                <a href="#contact" class="btn-elegant hidden lg:inline-flex border border-white/50 px-6 py-2.5 font-cinzel text-xs uppercase tracking-widest hover:opacity-70 transition-opacity">
                    {labelsData.header.reserve}
                </a>

                <div class="hidden lg:block">
                    <LanguageSwitcher lang={lang} />
                </div>

                <button id="mobile-menu-btn" class="lg:hidden p-2 text-white hover:opacity-70 transition-opacity" aria-label={labelsData.header.mobileMenuAria} aria-expanded="false">
                    <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
            </div>

        </div>
    </div>

    {/* Menú Mobile Desplegable */}
    <div id="mobile-menu" class="lg:hidden fixed inset-0 top-20 sm:top-24 bg-ragazza-dark max-h-screen overflow-y-auto z-40 translate-y-full transition-transform duration-300 ease-out">
        <nav class="flex flex-col px-6 py-8">
            {navItems.map(item => (
                    <a href={item.path} class="font-cinzel text-2xl sm:text-3xl uppercase tracking-widest text-white border-b border-white/10 py-6 hover:opacity-70 transition-opacity duration-200">
                        {item.name}
                    </a>
            ))}

            {/* Language Switcher y Reserve Button en el menú móvil */}
            <div class="pt-8 pb-4 flex justify-between items-center">
                <a href="#contact" class="btn-elegant border border-white/50 px-4 py-2 font-cinzel text-xs uppercase tracking-widest hover:opacity-70 transition-opacity text-white">
                    {labelsData.header.reserve}
                </a>
                <LanguageSwitcher lang={lang} />
            </div>
        </nav>
    </div>
</header>

<script>
    const initHeaderMenu = () => {
        const header = document.getElementById('main-header');
        if (!header || header.dataset.menuInitialized === 'true') return;
        header.dataset.menuInitialized = 'true';

        const headerContainer = document.getElementById('header-container');
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        let isMenuOpen = false;

        const menuIcon = '<svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>';
        const closeIcon = '<svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>';

        const setMenuState = (open: boolean) => {
            isMenuOpen = open;
            if (open) {
                mobileMenu?.classList.remove('translate-y-full');
                mobileMenu?.classList.add('translate-y-0');
                if (mobileBtn) {
                    mobileBtn.innerHTML = closeIcon;
                    mobileBtn.setAttribute('aria-expanded', 'true');
                }
                document.body.style.overflow = 'hidden';
                return;
            }

            mobileMenu?.classList.add('translate-y-full');
            mobileMenu?.classList.remove('translate-y-0');
            if (mobileBtn) {
                mobileBtn.innerHTML = menuIcon;
                mobileBtn.setAttribute('aria-expanded', 'false');
            }
            document.body.style.overflow = '';
        };

        const closeMenu = () => setMenuState(false);
        const isDesktop = () => window.innerWidth >= 1024;

        const applyHeaderState = () => {
            const scrolled = window.scrollY > 50;

            if (isDesktop()) {
                if (scrolled) {
                    headerContainer?.classList.remove('lg:h-28');
                    headerContainer?.classList.add('lg:h-24');
                } else {
                    headerContainer?.classList.add('lg:h-28');
                    headerContainer?.classList.remove('lg:h-24');
                }
            }
        };

        applyHeaderState();

        let scrollTimeout: ReturnType<typeof setTimeout> | null = null;
        window.addEventListener('scroll', () => {
            if (scrollTimeout) return;
            scrollTimeout = setTimeout(() => {
                applyHeaderState();
                scrollTimeout = null;
            }, 100);
        }, { passive: true });

        let resizeTimeout: ReturnType<typeof setTimeout> | null = null;
        window.addEventListener('resize', () => {
            if (resizeTimeout) clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                applyHeaderState();
                if (isDesktop()) {
                    closeMenu();
                }
            }, 150);
        }, { passive: true });

        mobileBtn?.addEventListener('click', () => {
            setMenuState(!isMenuOpen);
        });

        mobileMenu?.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', closeMenu, { passive: true });
        });
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHeaderMenu);
    } else {
        initHeaderMenu();
    }

    document.addEventListener('astro:page-load', initHeaderMenu);
</script>
