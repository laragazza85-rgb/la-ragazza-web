---
// src/components/ui/Header.astro
import { useTranslations } from '../../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
    lang?: string;
}

const lang = (Astro.props.lang || 'es') as 'es' | 'en';
const t = useTranslations(lang);
const labelsData = await import(`../../data/${lang}/labels.json`).then(m => m.default);

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const isActivePath = (path: string) => {
    const normalizedTarget = normalizePath(path);
    const homePath = `/${lang}`;

    if (normalizedTarget === homePath) {
        return currentPath === homePath;
    }

    return currentPath === normalizedTarget || currentPath.startsWith(`${normalizedTarget}/`);
};

const navItems = [
    { name: t('nav.home'), path: `/${lang}/` },
    { name: t('nav.about'), path: `/${lang}/about` },
    { name: t('nav.menu'), path: `/${lang}/menu` },
    { name: t('nav.gallery'), path: `/${lang}/gallery` },
].map((item) => ({ ...item, active: isActivePath(item.path) }));

const reserveHref = `/${lang}/#contact`;
---

<header
    id="main-header"
    class="fixed w-full top-0 z-50 transition-all duration-500 border-b text-white border-white/10 bg-ragazza-dark"
>
    <div class="w-full px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20 sm:h-24 md:h-28 transition-all duration-500" id="header-container">
            <a href={`/${lang}/`} class="font-cinzel text-2xl sm:text-3xl md:text-4xl font-bold tracking-widest z-50 hover:text-ragazza-accent transition-colors whitespace-nowrap">
                LA RAGAZZA
            </a>

            <nav class="hidden md:flex space-x-10">
                {navItems.map((item) => (
                    <a
                        href={item.path}
                        aria-current={item.active ? 'page' : undefined}
                        class:list={[
                            'font-cinzel text-sm uppercase tracking-widest transition-colors relative group',
                            item.active ? 'text-ragazza-accent' : 'hover:text-ragazza-accent',
                        ]}
                    >
                        {item.name}
                        <span class:list={[
                            'absolute -bottom-2 left-0 h-px bg-ragazza-accent transition-all duration-300',
                            item.active ? 'w-full' : 'w-0 group-hover:w-full',
                        ]}></span>
                    </a>
                ))}
            </nav>

            <div class="flex items-center gap-4 md:gap-6 z-50">
                <a href={reserveHref} class="hidden md:inline-flex border border-white/50 px-6 py-2.5 font-cinzel text-xs uppercase tracking-widest hover:bg-white hover:text-ragazza-primary transition-all duration-300">
                    {labelsData.header.reserve}
                </a>

                <div class="hidden md:block">
                    <LanguageSwitcher lang={lang} />
                </div>

                <button id="mobile-menu-btn" class="md:hidden p-2 text-white hover:text-ragazza-accent transition-colors" aria-label="Menu" aria-expanded="false">
                    <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <div id="mobile-menu" class="md:hidden fixed inset-0 top-20 sm:top-24 bg-ragazza-dark max-h-screen overflow-y-auto z-40 translate-y-full transition-transform duration-500">
        <nav class="flex flex-col px-6 py-8">
            {navItems.map((item) => (
                <a
                    href={item.path}
                    aria-current={item.active ? 'page' : undefined}
                    class:list={[
                        'font-cinzel text-2xl sm:text-3xl uppercase tracking-widest border-b border-white/10 py-6 transition-colors',
                        item.active ? 'text-ragazza-accent' : 'text-white hover:text-ragazza-accent',
                    ]}
                >
                    {item.name}
                </a>
            ))}

            <div class="pt-8 pb-4 flex justify-between items-center gap-3">
                <a href={reserveHref} class="border border-white/50 px-4 py-2 font-cinzel text-xs uppercase tracking-widest hover:bg-white hover:text-ragazza-primary transition-all duration-300 text-white">
                    {labelsData.header.reserve}
                </a>
                <LanguageSwitcher lang={lang} />
            </div>
        </nav>
    </div>
</header>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const headerContainer = document.getElementById('header-container');
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        let isMenuOpen = false;

        const menuIcon = '<svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>';
        const closeIcon = '<svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>';

        const setMenuState = (open) => {
            isMenuOpen = open;
            if (open) {
                mobileMenu?.classList.remove('translate-y-full');
                mobileMenu?.classList.add('translate-y-0');
                if (mobileBtn) {
                    mobileBtn.innerHTML = closeIcon;
                    mobileBtn.setAttribute('aria-expanded', 'true');
                }
                document.body.style.overflow = 'hidden';
                return;
            }

            mobileMenu?.classList.add('translate-y-full');
            mobileMenu?.classList.remove('translate-y-0');
            if (mobileBtn) {
                mobileBtn.innerHTML = menuIcon;
                mobileBtn.setAttribute('aria-expanded', 'false');
            }
            document.body.style.overflow = '';
        };

        const closeMenu = () => setMenuState(false);
        const isDesktop = () => window.innerWidth >= 768;

        const applyHeaderState = () => {
            const scrolled = window.scrollY > 50;

            if (isDesktop()) {
                if (scrolled) {
                    headerContainer?.classList.remove('md:h-28');
                    headerContainer?.classList.add('md:h-24');
                } else {
                    headerContainer?.classList.add('md:h-28');
                    headerContainer?.classList.remove('md:h-24');
                }
            }
        };

        applyHeaderState();

        let scrollTimeout = null;
        window.addEventListener('scroll', () => {
            if (scrollTimeout) return;
            scrollTimeout = setTimeout(() => {
                applyHeaderState();
                scrollTimeout = null;
            }, 100);
        }, { passive: true });

        let resizeTimeout = null;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                applyHeaderState();
                if (isDesktop()) {
                    closeMenu();
                }
            }, 150);
        }, { passive: true });

        mobileBtn?.addEventListener('click', () => {
            setMenuState(!isMenuOpen);
        });

        mobileMenu?.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', closeMenu, { passive: true });
        });
    });
</script>
