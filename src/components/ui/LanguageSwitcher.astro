---
interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const otherLang = lang === 'es' ? 'en' : 'es';
const currentPath = Astro.url.pathname.replace(`/${lang}/`, '');
const targetPath = `/${otherLang}/${currentPath}`;

const labels = {
  en: {
    toggle: 'Switch to Spanish',
    current: 'English',
  },
  es: {
    toggle: 'Cambiar a inglés',
    current: 'Español',
  },
};

const label = labels[lang];
---

<a
  href={targetPath}
  class="flex items-center gap-2 px-4 py-2 font-cinzel text-xs uppercase tracking-widest border border-white/50 hover:bg-white hover:text-ragazza-primary transition-all duration-300"
  aria-label={label.toggle}
  title={label.toggle}
>
  <span class="font-bold">{lang.toUpperCase()}</span>
  <svg
    class="w-4 h-4"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064A7.002 7.002 0 008 3.935z"
    />
  </svg>
</a>

