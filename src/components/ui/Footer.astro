---
// src/components/ui/Footer.astro
import { useTranslations } from '../../i18n/utils';

interface Props {
    lang?: string;
}

const lang = (Astro.props.lang || 'es') as 'es' | 'en';
const t = useTranslations(lang);
const labelsData = await import(`../../data/${lang}/labels.json`).then((m) => m.default);
const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const isActivePath = (path: string) => {
    const normalizedTarget = normalizePath(path);
    const homePath = `/${lang}`;

    if (normalizedTarget === homePath) {
        return currentPath === homePath;
    }

    return currentPath === normalizedTarget || currentPath.startsWith(`${normalizedTarget}/`);
};

const footerLinks = [
    { label: t('nav.home'), href: `/${lang}/` },
    { label: t('nav.menu'), href: `/${lang}/menu` },
    { label: t('nav.about'), href: `/${lang}/about` },
    { label: t('nav.gallery'), href: `/${lang}/gallery` },
].map((link) => ({ ...link, active: isActivePath(link.href) }));
---

<footer class="bg-ragazza-secondary text-ragazza-bg py-8">
    <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4">

        <div class="flex items-center gap-3">
            <span class="font-cinzel font-bold text-xl tracking-wider">{labelsData.brand.name}</span>
            <span class="text-ragazza-bg/30 hidden md:inline">|</span>
            <span class="font-lora text-sm text-ragazza-bg/70 italic hidden md:inline">{t('footer.family')}</span>
        </div>

        <nav aria-label={labelsData.footer.navAria} class="flex items-center gap-5 md:gap-6">
            {footerLinks.map((link) => (
                <a
                    href={link.href}
                    aria-current={link.active ? 'page' : undefined}
                    class:list={[
                        'font-cinzel text-xs uppercase tracking-widest transition-colors',
                        link.active ? 'text-ragazza-accent' : 'text-ragazza-bg/80 hover:text-ragazza-accent',
                    ]}
                >
                    {link.label}
                </a>
            ))}
        </nav>

        <div class="font-lora text-sm text-ragazza-bg/50 text-center md:text-right">
            &copy; {currentYear} {labelsData.footer.copyright}. {t('footer.rights')}
        </div>

    </div>
</footer>
