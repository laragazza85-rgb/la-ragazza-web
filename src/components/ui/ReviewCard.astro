---
export interface Props {
    text: string;
    stars: number;
}
const { text, stars } = Astro.props;
---
<article class="card-elegant w-full shrink-0 p-8 md:p-16 flex flex-col justify-center items-center text-center bg-ragazza-surface min-h-96">
    <div class="review-stars">
        {[...Array(5)].map((_, i) => (
            <svg width="28" height="28" viewBox="0 0 24 24" class={i < stars ? 'review-star-filled' : 'review-star-empty'}>
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
            </svg>
        ))}
    </div>
    <p class="review-text font-lora text-xl md:text-2xl italic leading-relaxed max-w-2xl flex-grow flex items-center">
        "{text}"
    </p>
</article>
