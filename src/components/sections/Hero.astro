---
// src/components/sections/Hero.astro
interface Props {
    lang?: string;
}

const lang = (Astro.props.lang || 'es') as 'es' | 'en';

// Importar datos del JSON según el idioma
const heroData = await import(`../../data/${lang}/hero.json`).then(m => m.default);
---

<header class="relative min-h-[60vh] sm:min-h-[70vh] md:min-h-[85vh] flex flex-col items-center justify-center text-center px-4 pt-28 pb-12 sm:pt-32 sm:pb-20 md:pt-40 overflow-hidden bg-ragazza-secondary">
    <div class="absolute inset-0 bg-[linear-gradient(180deg,#3b1616_0%,#331717_100%)] z-0"></div>

    <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center motion-fade-up">

        <h1 class="font-cinzel text-3xl sm:text-5xl md:text-7xl lg:text-8xl text-white font-bold tracking-tight mb-4 sm:mb-6 drop-shadow-lg" style="animation-delay: 0.08s;">
            {lang === 'es' ? 'Restaurante Italiano La Ragazza' : 'La Ragazza Italian Restaurant'}
        </h1>

        <div class="sauce-line mx-auto mb-4 sm:mb-8"></div>

        <p class="font-lora text-sm sm:text-lg md:text-xl lg:text-2xl text-white/90 italic font-light max-w-2xl leading-relaxed motion-fade-up" style="animation-delay: 0.18s;">
            {heroData.subtitle}
        </p>

        <div class="mt-8 sm:mt-12 flex flex-col sm:flex-row gap-3 sm:gap-4 motion-fade-up" style="animation-delay: 0.28s;">
            <a href={`/${lang}/menu`} class="btn-elegant px-6 sm:px-8 py-2 sm:py-3 text-xs sm:text-sm bg-white text-ragazza-primary font-cinzel font-bold tracking-wider hover:bg-ragazza-bg transition-colors duration-300">
                {heroData.viewMenu}
            </a>
            <a href="#contact" class="btn-elegant px-6 sm:px-8 py-2 sm:py-3 text-xs sm:text-sm bg-transparent border border-white text-white font-cinzel font-bold tracking-wider hover:bg-white/10 transition-colors duration-300">
                {heroData.reserveTable}
            </a>
        </div>

    </div>
</header>
