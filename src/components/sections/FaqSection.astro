---
import { getFaqData } from '../../lib/i18n-data';

interface Props {
  lang?: string;
}

const lang = (Astro.props.lang || 'es') as 'es' | 'en';
const faqData = getFaqData(lang) as { label: string; title: string; items: { question: string; answer: string }[] };

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.items.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section class="py-20 bg-white dark:bg-ragazza-surface reveal opacity-0 translate-y-8 transition-all duration-1000" aria-labelledby="faq-title">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <span class="font-cinzel text-ragazza-accent tracking-widest text-sm uppercase font-bold">{faqData.label}</span>
      <h2 id="faq-title" class="font-cinzel text-3xl md:text-5xl text-ragazza-primary dark:text-ragazza-ink mt-4">{faqData.title}</h2>
      <div class="w-16 h-0.5 bg-ragazza-primary/30 mx-auto mt-6"></div>
    </div>

    <div class="space-y-4" data-faq-accordion>
      {faqData.items.map((item: { question: string; answer: string }, index: number) => {
        const panelId = `faq-panel-${lang}-${index}`;
        const buttonId = `faq-button-${lang}-${index}`;

        return (
          <article class="border border-ragazza-primary/10 dark:border-white/10 bg-ragazza-bg/40 dark:bg-ragazza-surface/60 p-5 transition-colors duration-200">
            <button
              id={buttonId}
              type="button"
              class="faq-trigger w-full font-cinzel text-ragazza-primary dark:text-ragazza-ink text-lg cursor-pointer flex items-center justify-between gap-4 text-left"
              aria-expanded="false"
              aria-controls={panelId}
            >
              <span>{item.question}</span>
              <span class="faq-icon text-ragazza-accent transition-transform duration-200">+</span>
            </button>

            <div
              id={panelId}
              class="faq-panel overflow-hidden max-h-0 opacity-0 transition-[max-height,opacity] duration-200 ease-out"
              role="region"
              aria-labelledby={buttonId}
            >
              <p class="font-lora text-ragazza-secondary/80 dark:text-ragazza-ink/70 mt-4 leading-relaxed">{item.answer}</p>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline></script>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accordion = document.querySelector('[data-faq-accordion]');
    if (!accordion) return;

    const items = Array.from(accordion.querySelectorAll('article'));

    const closeItem = (item: Element) => {
      const trigger = item.querySelector('.faq-trigger');
      const panel = item.querySelector('.faq-panel');
      const icon = item.querySelector('.faq-icon');
      if (!(trigger instanceof HTMLButtonElement) || !(panel instanceof HTMLElement) || !(icon instanceof HTMLElement)) return;

      trigger.setAttribute('aria-expanded', 'false');
      panel.style.maxHeight = `${panel.scrollHeight}px`;
      requestAnimationFrame(() => {
        panel.style.maxHeight = '0px';
        panel.classList.add('opacity-0');
      });
      icon.classList.remove('rotate-45');
      item.classList.remove('bg-white', 'dark:bg-ragazza-surface-raised');
      item.classList.add('bg-ragazza-bg/40', 'dark:bg-ragazza-surface/60');
    };

    const openItem = (item: Element) => {
      const trigger = item.querySelector('.faq-trigger');
      const panel = item.querySelector('.faq-panel');
      const icon = item.querySelector('.faq-icon');
      if (!(trigger instanceof HTMLButtonElement) || !(panel instanceof HTMLElement) || !(icon instanceof HTMLElement)) return;

      trigger.setAttribute('aria-expanded', 'true');
      panel.classList.remove('opacity-0');
      panel.style.maxHeight = `${panel.scrollHeight}px`;
      icon.classList.add('rotate-45');
      item.classList.remove('bg-ragazza-bg/40', 'dark:bg-ragazza-surface/60');
      item.classList.add('bg-white', 'dark:bg-ragazza-surface-raised');
    };

    items.forEach((item) => {
      const trigger = item.querySelector('.faq-trigger');
      if (!(trigger instanceof HTMLButtonElement)) return;

      trigger.addEventListener('click', () => {
        const expanded = trigger.getAttribute('aria-expanded') === 'true';

        if (expanded) {
          closeItem(item);
          return;
        }

        items.forEach((otherItem) => {
          if (otherItem !== item) closeItem(otherItem);
        });

        openItem(item);
      });
    });
  });
</script>

