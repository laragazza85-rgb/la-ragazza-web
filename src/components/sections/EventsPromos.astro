---
import { getEventsData } from '../../lib/i18n-data';

interface Props {
  lang?: string;
}

const lang = (Astro.props.lang || 'es') as 'es' | 'en';
const eventsData = getEventsData(lang);
---

<section class="py-20 bg-ragazza-bg reveal opacity-0 translate-y-8 transition-all duration-1000" aria-labelledby="events-title">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="font-cinzel text-ragazza-accent tracking-widest text-sm uppercase font-bold">{eventsData.label}</span>
      <h2 id="events-title" class="font-cinzel text-3xl md:text-5xl text-ragazza-primary mt-4">{eventsData.title}</h2>
      <div class="w-16 h-0.5 bg-ragazza-primary/30 mx-auto mt-6"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {eventsData.events.map((event: { name: string; description: string; badge: string }) => (
        <article class="bg-white border border-ragazza-primary/10 p-6 shadow-sm hover:shadow-md transition-shadow duration-300">
          <span class="inline-flex text-[11px] uppercase tracking-widest font-cinzel text-ragazza-accent border border-ragazza-accent/30 px-2 py-1 mb-4">
            {event.badge}
          </span>
          <h3 class="font-cinzel text-xl text-ragazza-primary mb-3">{event.name}</h3>
          <p class="font-lora text-ragazza-secondary/80 leading-relaxed">{event.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

