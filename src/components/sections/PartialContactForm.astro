---
interface Props {
  lang?: 'es' | 'en';
}

const lang = (Astro.props.lang || 'es') as 'es' | 'en';
const formData = await import(`../../data/${lang}/partial-form.json`).then((m) => m.default);
---

<section class="pt-36 pb-28 md:pt-40 bg-ragazza-bg px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-10">
      <span class="font-cinzel text-ragazza-accent tracking-widest text-sm uppercase font-bold">{formData.label}</span>
      <h1 class="font-cinzel text-4xl md:text-5xl text-ragazza-primary mt-4">{formData.title}</h1>
      <p class="font-lora text-ragazza-secondary/80 mt-4 leading-relaxed">{formData.description}</p>
      <div class="sauce-line mx-auto mt-6"></div>
    </div>

    <div class="rounded-2xl border border-ragazza-primary/15 bg-white/95 p-6 sm:p-8 shadow-sm card-elegant">
      <p class="mb-4 font-lora text-xs text-ragazza-secondary/70">* {lang === 'es' ? 'Campos obligatorios' : 'Required fields'}</p>
      <form id="partial-contact-form" class="space-y-5" novalidate>
        <div>
          <label for="fullName" class="font-cinzel text-xs uppercase tracking-widest text-ragazza-primary">* {formData.fields.name.label}</label>
          <input
            id="fullName"
            name="fullName"
            type="text"
            required
            minlength="2"
            maxlength="80"
            placeholder={formData.fields.name.placeholder}
            class="mt-2 w-full rounded-xl border border-ragazza-primary/20 bg-white px-4 py-3 font-lora text-ragazza-dark focus:border-ragazza-accent focus:outline-none focus:ring-2 focus:ring-ragazza-accent/30"
          />
          <p data-error-for="fullName" class="mt-1 text-sm text-red-700 hidden"></p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label for="email" class="font-cinzel text-xs uppercase tracking-widest text-ragazza-primary">* {formData.fields.email.label}</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder={formData.fields.email.placeholder}
              class="mt-2 w-full rounded-xl border border-ragazza-primary/20 bg-white px-4 py-3 font-lora text-ragazza-dark focus:border-ragazza-accent focus:outline-none focus:ring-2 focus:ring-ragazza-accent/30"
            />
            <p data-error-for="email" class="mt-1 text-sm text-red-700 hidden"></p>
          </div>

          <div>
            <label for="phone" class="font-cinzel text-xs uppercase tracking-widest text-ragazza-primary">* {formData.fields.phone.label}</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              required
              inputmode="tel"
              pattern="\+[0-9]{1,4}[\s-]?[0-9]{6,14}"
              placeholder={formData.fields.phone.placeholder}
              class="mt-2 w-full rounded-xl border border-ragazza-primary/20 bg-white px-4 py-3 font-lora text-ragazza-dark focus:border-ragazza-accent focus:outline-none focus:ring-2 focus:ring-ragazza-accent/30"
            />
            <p class="mt-1 text-xs text-ragazza-secondary/70">{formData.fields.phone.hint}</p>
            <p data-error-for="phone" class="mt-1 text-sm text-red-700 hidden"></p>
          </div>
        </div>

        <div>
          <label for="inquiryType" class="font-cinzel text-xs uppercase tracking-widest text-ragazza-primary">* {formData.fields.inquiryType.label}</label>
          <select
            id="inquiryType"
            name="inquiryType"
            required
            class="mt-2 w-full rounded-xl border border-ragazza-primary/20 bg-white px-4 py-3 font-lora text-ragazza-dark focus:border-ragazza-accent focus:outline-none focus:ring-2 focus:ring-ragazza-accent/30"
          >
            <option value="">{formData.fields.inquiryType.placeholder}</option>
            {formData.fields.inquiryType.options.map((option: { value: string; label: string }) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
          <p data-error-for="inquiryType" class="mt-1 text-sm text-red-700 hidden"></p>
        </div>

        <div>
          <label for="message" class="font-cinzel text-xs uppercase tracking-widest text-ragazza-primary">* {formData.fields.message.label}</label>
          <textarea
            id="message"
            name="message"
            required
            minlength="10"
            maxlength="600"
            rows="6"
            placeholder={formData.fields.message.placeholder}
            class="mt-2 w-full rounded-xl border border-ragazza-primary/20 bg-white px-4 py-3 font-lora text-ragazza-dark focus:border-ragazza-accent focus:outline-none focus:ring-2 focus:ring-ragazza-accent/30"
          ></textarea>
          <p data-error-for="message" class="mt-1 text-sm text-red-700 hidden"></p>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row sm:items-center gap-3">
          <button type="submit" class="btn-elegant inline-flex items-center justify-center rounded-full bg-ragazza-primary px-6 py-3 font-cinzel text-xs uppercase tracking-widest text-white hover:bg-ragazza-secondary">
            {formData.actions.submit}
          </button>
          <p class="font-lora text-xs text-ragazza-secondary/70">{formData.footnote}</p>
        </div>

        <p id="form-status" class="hidden rounded-lg px-4 py-3 text-sm font-lora" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ validation: formData.validation, labels: formData.fields }}>
  const form = document.getElementById('partial-contact-form');
  const status = document.getElementById('form-status');

  if (form && status) {
    const setFieldError = (field, message) => {
      const target = form.querySelector(`[data-error-for="${field.name}"]`);
      if (!target) return;

      if (message) {
        field.setAttribute('aria-invalid', 'true');
        target.textContent = message;
        target.classList.remove('hidden');
      } else {
        field.removeAttribute('aria-invalid');
        target.textContent = '';
        target.classList.add('hidden');
      }
    };

    const isFullNameValid = (value) => value.trim().split(/\s+/).filter(Boolean).length >= 2;
    const isEmailComValid = (value) => /^[^\s@]+@[^\s@]+\.com$/i.test(value.trim());
    const isPhoneValid = (value) => /^\+[0-9]{1,4}[\s-]?[0-9]{6,14}$/.test(value.trim());

    const getMessageForField = (field) => {
      if (field.validity.valueMissing) {
        if (field.name === 'inquiryType') return validation.inquiryRequired;
        return validation.required;
      }

      if (field.name === 'fullName' && !isFullNameValid(field.value)) return validation.fullNameWords;
      if (field.name === 'email' && !isEmailComValid(field.value)) return validation.invalidEmail;
      if (field.name === 'phone' && !isPhoneValid(field.value)) return validation.invalidPhone;
      if (field.name === 'message' && field.validity.tooShort) return validation.shortMessage;
      if (field.name === 'fullName' && field.validity.tooShort) return validation.shortName;

      return '';
    };

    const normalizeFieldValue = (field) => {
      if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement)) {
        return;
      }

      if (field.name === 'email' || field.name === 'phone') {
        field.value = field.value.trim();
      }

      if (field.name === 'fullName') {
        // Keep inner spaces while typing; only remove accidental leading/trailing spaces.
        field.value = field.value.replace(/^\s+|\s+$/g, '');
      }
    };

    const validateField = (field) => {
      if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement)) {
        return true;
      }

      const message = getMessageForField(field);
      setFieldError(field, message);
      return !message;
    };

    const clearStatus = () => {
      status.className = 'hidden rounded-lg px-4 py-3 text-sm font-lora';
      status.textContent = '';
    };

    form.querySelectorAll('input, textarea, select').forEach((field) => {
      field.addEventListener('input', () => {
        validateField(field);
        clearStatus();
      });
      field.addEventListener('change', () => {
        normalizeFieldValue(field);
        validateField(field);
        clearStatus();
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const fields = Array.from(form.querySelectorAll('input, textarea, select'));
      fields.forEach((field) => normalizeFieldValue(field));
      const invalidField = fields.find((field) => !validateField(field));

      if (invalidField) {
        status.textContent = validation.error;
        status.className = 'rounded-lg px-4 py-3 text-sm font-lora bg-red-100 text-red-800';
        invalidField.focus();
        return;
      }

      const payload = Object.fromEntries(new FormData(form).entries());
      console.info('Partial form captured data:', payload);

      status.textContent = validation.success;
      status.className = 'rounded-lg px-4 py-3 text-sm font-lora bg-emerald-100 text-emerald-800';
      form.reset();
    });
  }
</script>

