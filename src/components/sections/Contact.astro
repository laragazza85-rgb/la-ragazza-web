---
// src/components/sections/Contact.astro
import { useTranslations } from '../../i18n/utils';
import { getContactData } from '../../lib/i18n-data';

interface Props {
    lang?: string;
}

const lang = (Astro.props.lang || 'es') as 'es' | 'en';
const t = useTranslations(lang);
const contactData = getContactData(lang) as {
  location: { mapLink?: string; mapEmbedUrl?: string; wazeLink?: string; streetAddress: string; city: string; state: string; country: string; label: string };
  whatsapp: { phoneNumber: string; message: string; label: string; description: string };
  family: { title: string; founded: string; owners: string; philosophy: string };
  ui: { map: { openAria: string; iframeTitle: string; title: string; google: string; waze: string }; aboutAria: string; social: { instagramAria: string; facebookAria: string }; title: string };
};

const mapLink = contactData.location.mapLink || 'https://maps.app.goo.gl/BXPjN95nZqAvGyiQ7';
const mapEmbedUrl = contactData.location.mapEmbedUrl || '';
const wazeLink = contactData.location.wazeLink || 'https://www.waze.com/ul?navigate=yes&to=place.w.187695145.1876689310.17328548';
const aboutUrl = `/${lang}/about`;

const mapLabels = contactData.ui.map;
// Configuración de WhatsApp
const phoneNumber = contactData.whatsapp.phoneNumber;
const message = encodeURIComponent(contactData.whatsapp.message);
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${message}`;
---

<section id="contact" class="py-24 bg-white dark:bg-ragazza-surface border-t border-ragazza-primary/10 dark:border-white/10 scroll-mt-0 reveal opacity-0 translate-y-8 transition-all duration-1000 ease-out">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="text-center mb-16">
            <span class="font-cinzel text-ragazza-accent tracking-widest text-sm uppercase font-bold">{t('contact.title')}</span>
            <h2 class="font-cinzel text-4xl md:text-5xl text-ragazza-primary dark:text-ragazza-ink mt-4">{contactData.ui.title}</h2>
            <div class="sauce-line mx-auto mt-6"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-12 text-center md:text-left">

            {/* Address */}
            <div class="flex flex-col items-center md:items-start">
                <a
                    href={mapLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={contactData.ui.map.openAria}
                    class="w-12 h-12 bg-ragazza-bg dark:bg-ragazza-surface-raised rounded-full flex items-center justify-center text-ragazza-primary dark:text-ragazza-ink mb-4 hover:bg-ragazza-primary hover:text-white active:scale-95 transition-colors duration-200"
                >
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </a>
                <h3 class="font-cinzel text-xl text-ragazza-ink font-bold mb-2">{contactData.location.label}</h3>
                <p class="font-lora text-ragazza-secondary/80 dark:text-ragazza-ink/70 leading-relaxed">
                    <a
                        href={mapLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline decoration-ragazza-primary/40 underline-offset-4 hover:text-ragazza-primary dark:hover:text-ragazza-accent transition-colors duration-300"
                    >
                        {contactData.location.streetAddress}
                    </a>
                    <br/>
                    {contactData.location.city}, {contactData.location.state}<br/>
                    {contactData.location.country}
                </p>
            </div>

            {/* Philosophy / Family Info */}
            <div class="flex flex-col items-center md:items-start">
                <a
                    href={aboutUrl}
                    aria-label={contactData.ui.aboutAria}
                    class="w-12 h-12 bg-ragazza-bg dark:bg-ragazza-surface-raised rounded-full flex items-center justify-center text-ragazza-primary dark:text-ragazza-ink mb-4 hover:bg-ragazza-primary hover:text-white active:scale-95 transition-colors duration-200"
                >
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </a>
                <h3 class="font-cinzel text-xl text-ragazza-ink font-bold mb-2">{contactData.family.title}</h3>
                <p class="font-lora text-ragazza-secondary/80 dark:text-ragazza-ink/70 leading-relaxed italic">
                    {contactData.family.founded}<br/>
                    {contactData.family.owners}<br/>
                    {contactData.family.philosophy}
                </p>
            </div>

            {/* WhatsApp CTA */}
            <div class="flex flex-col items-center md:items-start md:col-span-2 lg:col-span-1 border-t md:border-t border-ragazza-primary/10 dark:border-white/10 pt-8 md:pt-8 lg:pt-0 lg:pl-12 lg:border-t-0 lg:border-l">
                <h3 class="font-cinzel text-xl text-ragazza-ink font-bold mb-4">{contactData.whatsapp.label}</h3>
                <p class="font-lora text-ragazza-secondary/70 dark:text-ragazza-ink/70 mb-6 text-sm">
                    {contactData.whatsapp.description}
                </p>
                <a
                        href={whatsappUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-elegant inline-flex items-center justify-center gap-2 bg-[#25D366] text-white px-6 py-3 rounded-full font-bold shadow-lg hover:bg-[#128C7E] transition-colors duration-300 w-full sm:w-auto"
                >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                    </svg>
                    {t('contact.cta')}
                </a>

                <div class="mt-6 flex items-center gap-3">
                    <a
                        href="https://www.instagram.com/laragazza85/"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={contactData.ui.social.instagramAria}
                        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-ragazza-primary/20 dark:border-white/20 text-ragazza-primary dark:text-ragazza-ink hover:bg-ragazza-primary hover:text-white active:scale-95 transition-colors duration-200"
                    >
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M7.75 2h8.5A5.757 5.757 0 0 1 22 7.75v8.5A5.757 5.757 0 0 1 16.25 22h-8.5A5.757 5.757 0 0 1 2 16.25v-8.5A5.757 5.757 0 0 1 7.75 2Zm0 1.8A3.955 3.955 0 0 0 3.8 7.75v8.5a3.955 3.955 0 0 0 3.95 3.95h8.5a3.955 3.955 0 0 0 3.95-3.95v-8.5a3.955 3.955 0 0 0-3.95-3.95h-8.5Zm8.85 1.35a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.8a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4Z" />
                        </svg>
                    </a>
                    <a
                        href="https://www.facebook.com/laragazza85/"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={contactData.ui.social.facebookAria}
                        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-ragazza-primary/20 dark:border-white/20 text-ragazza-primary dark:text-ragazza-ink hover:bg-ragazza-primary hover:text-white active:scale-95 transition-colors duration-200"
                    >
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.5 1.6-1.5h1.7V4.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V11H8v3h2.1v8h3.4Z" />
                        </svg>
                    </a>
                </div>
            </div>

        </div>

        {mapEmbedUrl && (
            <div class="mt-14">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
                    <h3 class="font-cinzel text-2xl text-ragazza-primary dark:text-ragazza-ink">{mapLabels.title}</h3>
                    <div class="flex items-center gap-3">
                        <a
                            href={mapLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-elegant inline-flex items-center justify-center border border-ragazza-primary/40 dark:border-white/30 px-4 py-2 font-cinzel text-xs uppercase tracking-widest text-ragazza-primary dark:text-ragazza-ink hover:bg-ragazza-primary hover:text-white transition-colors duration-300"
                        >
                            {mapLabels.google}
                        </a>
                        <a
                            href={wazeLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-elegant inline-flex items-center justify-center border border-ragazza-primary/40 dark:border-white/30 px-4 py-2 font-cinzel text-xs uppercase tracking-widest text-ragazza-primary dark:text-ragazza-ink hover:bg-ragazza-primary hover:text-white transition-colors duration-300"
                        >
                            {mapLabels.waze}
                        </a>
                    </div>
                </div>

                <div class="overflow-hidden rounded-xl border border-ragazza-primary/10 dark:border-white/10 shadow-sm">
                    <iframe
                        src={mapEmbedUrl}
                        class="w-full h-[320px] md:h-[420px] border-0"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        allowfullscreen
                        title={contactData.ui.map.iframeTitle}
                    ></iframe>
                </div>
            </div>
        )}
    </div>
</section>

